local URL = "https://raw.githubusercontent.com/Nxy67969/Luna/refs/heads/main/Ohio"

local function Http(u)
    local f = (syn and syn.request) or request or http_request
    if f then
        local ok, r = pcall(f, { Url = u, Method = "GET" })
        if ok and r then
            return type(r) == "table" and tostring(r.Body or r.body or "") or tostring(r)
        end
    end
    return game:HttpGet(u)
end

local function Notify(text)
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", { Title = "Luna", Text = tostring(text), Duration = 6 })
    end)
end

local function CleanKey(text)
    local k = tostring(text or "")
    k = k:match('SCRIPT_KEY%s*=%s*"(.-)"') or k:match('"(.-)"') or k
    return (k:gsub("%s", ""))
end

local function Run(key)
    key = CleanKey(key)
    if key == "" then
        Notify("请输入卡密")
        return false
    end
    getgenv().SCRIPT_KEY = key
    SCRIPT_KEY = key
    task.spawn(function()
        local ok, err = pcall(function()
            local src = Http(URL)
            if type(src) ~= "string" or src == "" then
                error("下载脚本失败")
            end
            local fn, perr = loadstring(src)
            if not fn then
                error(perr or "编译失败")
            end
            fn()
        end)
        if not ok then
            Notify("执行失败: " .. tostring(err))
            warn("[Luna] " .. tostring(err))
        end
    end)
    return true
end

if getgenv and getgenv().SCRIPT_KEY and getgenv().SCRIPT_KEY ~= "" then
    Run(getgenv().SCRIPT_KEY)
    return
end

